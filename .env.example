# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used for inviting users and the scheduled PM/compliance generator.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public URL of the app (used in invite emails / magic links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for /api/cron/generate (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me
# Tech schedule emails (https://resend.com). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=MaintenanceOS <dispatch@yourcompany.com>
# Optional: where tech replies go
EMAIL_REPLY_TO=
# Optional: display timezone (default America/Los_Angeles)
NEXT_PUBLIC_TIMEZONE=America/Los_Angeles
# External vendor links: any long random string (e.g. `openssl rand -base64 48`).
# Changing it invalidates every outstanding vendor link.
LINK_SIGNING_SECRET=
# Name shown on the vendor portal and in vendor emails
NEXT_PUBLIC_COMPANY_NAME=Del Taco Maintenance
# Extra addresses for vendor activity alerts (admins + the dispatcher always get them)
VENDOR_NOTIFY_EMAILS=
# Email replies → work order (see README "Email replies"). Subdomain whose mail Resend receives.
REPLY_DOMAIN=reply.yourcompany.com
# Signing secret of the Resend webhook for email.received (starts with whsec_)
RESEND_WEBHOOK_SECRET=
